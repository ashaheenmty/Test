{
  "name": "@tb/api",
  "version": "0.1.0",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "start": "node dist/main.js",
    "dev": "tsc -p tsconfig.build.json && (tsc -p tsconfig.build.json --watch --preserveWatchOutput & node --env-file-if-exists=../../.env --watch dist/main.js)",
    "test": "vitest run --dir src",
    "test:integration": "INTEGRATION=1 vitest run --dir test"
  },
  "dependencies": {
    "@nestjs/common": "11.2.6",
    "@nestjs/core": "11.2.6",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/platform-express": "11.2.6",
    "@nestjs/throttler": "6.7.1",
    "@tb/config": "workspace:*",
    "@tb/db": "workspace:*",
    "@tb/domain": "workspace:*",
    "@tb/i18n": "workspace:*",
    "argon2": "0.45.1",
    "helmet": "8.3.0",
    "jose": "5.10.0",
    "nodemailer": "7.0.13",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@nestjs/testing": "11.2.6",
    "@swc/core": "1.16.12",
    "@types/express": "5.0.6",
    "@types/nodemailer": "7.0.12",
    "@types/supertest": "6.0.3",
    "supertest": "7.1.4",
    "unplugin-swc": "1.6.0",
    "typescript": "5.9.3"
  }
}
