// Data model for the multi-operator transport booking agent.
//
// Two PostgreSQL schemas:
//   app     – account, profile, reference data, configuration. Deletable on user request.
//   records – bookings, payments, documents, audit. Legally retained (tax/commercial law),
//             access-restricted, never cascade-deleted from a user account.
//
// Monetary values are integer minor units (cents) + ISO currency.
// Percentages are basis points (1 % = 100 bp).
// Enum values must match packages/domain/src/enums.ts (enforced by a test).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["app", "records"]
}

