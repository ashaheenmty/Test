# Copy to .env (repo root) and to packages/db/.env:  cp .env.example .env && cp .env packages/db/.env
# Every key used anywhere in the monorepo is listed here.

NODE_ENV=development

# ── Database / queues ──
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tb?schema=app
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tb_test?schema=app
REDIS_URL=redis://localhost:6379

# ── API (apps/api) ──
PORT=4000
# Generate each with: openssl rand -base64 36   (the two must differ)
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters
JWT_ADMIN_SECRET=change-me-admin-secret-at-least-32-characters-2
# AES-256 keys for personal fields: "keyId:base64(32 bytes)", comma-separated; first key encrypts.
# Generate with: echo "k1:$(openssl rand -base64 32)"
FIELD_ENCRYPTION_KEYS=k1:REPLACE_WITH_openssl_rand_base64_32
APP_WEB_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:8081
TRUST_PROXY=false
# Email: Mailpit locally (docker compose). Leave empty to log mails to the console.
SMTP_URL=smtp://localhost:1025
MAIL_FROM="Durch Deutschland <no-reply@example.com>"
# Sign in with Apple / Google. Mock tokens ("mock.<provider>.<sub>.<email>") only outside production.
AUTH_OAUTH_MOCK=true
APPLE_CLIENT_IDS=
GOOGLE_CLIENT_IDS=
# Only for automated tests; refused in production.
THROTTLE_DISABLED=false
# Optional JSON deep-merged over packages/config defaults (legal/tax/business settings).
SETTINGS_JSON=

# ── Seed (packages/db) ──
SEED_ADMIN_EMAIL=admin@example.com
# If empty, a random password is generated and printed once.
SEED_ADMIN_PASSWORD="local admin passphrase"

# ── Web / admin (apps/web, apps/admin) ──
API_URL=http://localhost:4000/v1
NEXT_PUBLIC_BRAND_NAME="Durch Deutschland"

# ── Mobile (apps/mobile, Expo) ──
# Use your machine's LAN IP when testing on a physical phone.
EXPO_PUBLIC_API_URL=http://localhost:4000/v1
EXPO_PUBLIC_BRAND_NAME="Durch Deutschland"
